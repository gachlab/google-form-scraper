{
  "name": "@gachlab/google-forms-scraper",
  "version": "1.1.0",
  "description": "Parse Google Forms into structured JSON. Extract titles, fields, options, and validation from any public Google Form URL.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist/"
  ],
  "author": "Guillermo Carrillo",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gachlab/google-form-scraper.git"
  },
  "bugs": {
    "url": "https://github.com/gachlab/google-form-scraper/issues"
  },
  "keywords": [
    "google-forms",
    "scraper",
    "parser",
    "form",
    "json",
    "html-parser"
  ],
  "scripts": {
    "build": "npm run clean && tsc --emitDeclarationOnly && node build.mjs",
    "clean": "rimraf ./dist",
    "lint": "prettier --check \"src/**/*.ts\"",
    "test": "node --import tsx/esm --test \"src/__tests__/**/*.test.ts\"",
    "prepublishOnly": "npm run build",
    "fmt": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "node-html-parser": "^6.1.12"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "prettier": "^3.8.0",
    "rimraf": "^6.1.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
