{
  "name": "@gachlab/google-forms-scraper",
  "version": "1.0.0",
  "description": "Parse Google Forms into structured JSON. Extract titles, fields, options, and validation from any public Google Form URL.",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist/"
  ],
  "author": "Guillermo Carrillo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gachlab/google-forms-scraper.git"
  },
  "bugs": {
    "url": "https://github.com/gachlab/google-forms-scraper/issues"
  },
  "keywords": [
    "google-forms",
    "scraper",
    "parser",
    "form",
    "json",
    "html-parser"
  ],
  "scripts": {
    "build": "npm run clean && vite build",
    "clean": "rimraf ./dist",
    "lint": "eslint src/",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "node-html-parser": "^6.1.12"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^9.39.2",
    "rimraf": "^6.1.2",
    "typescript": "^6.0.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^3.2.1"
  }
}
